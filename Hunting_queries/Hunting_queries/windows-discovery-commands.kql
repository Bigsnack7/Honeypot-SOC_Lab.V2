Event
| where TimeGenerated >= ago(1d)
| where Source == "Microsoft-Windows-Sysmon" and EventID == 1
| extend EvData = parse_xml(EventData).DataItem.EventData.Data
| extend Image = tostring(EvData[4].["#text"]),
         CommandLine = tostring(EvData[10].["#text"]),
         ParentImage = tostring(EvData[20].["#text"]),
         ParentCommandLine = tostring(EvData[21].["#text"])
| where Image has_any (
    "whoami.exe", "systeminfo.exe", "ipconfig.exe", "nltest.exe",
    "net.exe", "net1.exe", "hostname.exe", "tasklist.exe",
    "quser.exe", "arp.exe", "route.exe", "nbtstat.exe")
| extend Technique = case(
    Image has_any ("whoami.exe", "quser.exe"), "T1033/T1087 - Account/User Discovery",
    Image has_any ("systeminfo.exe", "hostname.exe", "tasklist.exe"), "T1082 - System Information Discovery",
    Image has_any ("ipconfig.exe", "arp.exe", "route.exe", "nbtstat.exe"), "T1016 - System Network Config Discovery",
    Image has "nltest.exe", "T1482 - Domain Trust Discovery",
    Image has_any ("net.exe", "net1.exe") and CommandLine has_any ("user", "group", "localgroup"), "T1087 - Account Discovery",
    "Uncategorized Discovery")
| project TimeGenerated, Computer, Image, CommandLine, ParentImage, ParentCommandLine, Technique
| sort by TimeGenerated desc
