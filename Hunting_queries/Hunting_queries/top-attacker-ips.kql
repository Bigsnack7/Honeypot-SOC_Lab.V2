let LookbackPeriod = 7d;
let ThreatIndicators = ThreatIntelligenceIndicator
    | where TimeGenerated >= ago(LookbackPeriod)
    | where isnotempty(NetworkIP)
    | summarize LatestIndicatorTime = arg_max(TimeGenerated, ThreatType, Confidence, Description) by NetworkIP;
union
(Cowrie_CL | extend Parsed = parse_json(RawData) | extend SourceIP = tostring(Parsed.src_ip), Source = "Cowrie SSH"),
(WebDecoy_CL | extend Parsed = parse_json(RawData) | extend SourceIP = tostring(Parsed.src_ip), Source = "Web Decoy"),
(SecurityEvent | where EventID == 4625 | extend SourceIP = IpAddress, Source = "Windows RDP")
| where isnotempty(SourceIP)
| summarize Count = count(), Sources = make_set(Source), LastSeen = max(TimeGenerated) by SourceIP
| join kind=leftouter (ThreatIndicators) on $left.SourceIP == $right.NetworkIP
| project SourceIP, Count, Sources, LastSeen, IsKnownThreat = iff(isnotempty(ThreatType), true, false), ThreatType, Confidence, Description
| sort by IsKnownThreat desc, Count desc
| take 25
