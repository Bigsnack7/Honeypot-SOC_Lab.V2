let lookback = 1d;
let ScheduledTasks = SecurityEvent
| where TimeGenerated >= ago(lookback)
| where EventID == 4698
| project TimeGenerated, Computer, Account, Activity,
          TaskName = extract(@"Task Name:\s*(.+)", 1, EventData),
          Technique = "T1053.005 - Scheduled Task Created";
let RunKeys = Event
| where TimeGenerated >= ago(lookback)
| where Source == "Microsoft-Windows-Sysmon" and EventID == 13
| extend EvData = parse_xml(EventData).DataItem.EventData.Data
| extend Image = tostring(EvData[5].["#text"]),
         TargetObject = tostring(EvData[6].["#text"]),
         Details = tostring(EvData[7].["#text"])
| where TargetObject has_any (@"CurrentVersion\Run", @"CurrentVersion\RunOnce", @"CurrentVersion\RunServices")
| project TimeGenerated, Computer, Image, TargetObject, Details,
          Technique = "T1547.001 - Registry Run Key";
let NewServices = SecurityEvent
| where TimeGenerated >= ago(lookback)
| where EventID == 4697
| project TimeGenerated, Computer, Account, Activity,
          ServiceName = extract(@"Service Name:\s*(.+)", 1, EventData),
          Technique = "T1543.003 - New Service Installed";
ScheduledTasks
| union RunKeys, NewServices
| sort by TimeGenerated desc
